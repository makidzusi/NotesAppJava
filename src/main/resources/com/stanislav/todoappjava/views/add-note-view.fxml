<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.stanislav.todoappjava.controllers.AddNoteController"
      spacing="15"
      alignment="TOP_CENTER"
      style="-fx-background-color: #121212; -fx-padding: 20;">

    <Label text="Создать заметку"
           style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold"/>

    <TextField fx:id="titleField"
               promptText="Заголовок"
               />

    <TextArea fx:id="contentField"
              promptText="Текст заметки..."
              VBox.vgrow="ALWAYS"
              />

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button onMouseClicked="#onCancelClick" text="Отмена"
                style="-fx-background-color: #333; -fx-text-fill: white;"/>

        <Button onMouseClicked="#onSaveClick" text="Сохранить"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </HBox>

</VBox>
